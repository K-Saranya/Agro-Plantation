PORT=4000
NODE_ENV=development

# sqlite runs with no extra database install.
# Switch to mysql to use the existing Agro database (no data is deleted).
DB_DIALECT=sqlite
DB_STORAGE=./data/agro.sqlite

# MySQL (used only when DB_DIALECT=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=agro
DB_USER=root
DB_PASSWORD=

# Comma-separated browser origins allowed to call the API
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000

# Change this before any shared or production deployment
JWT_SECRET=replace-with-a-long-random-string

# Created only when the users table is empty
ADMIN_EMAIL=admin@agro.test
ADMIN_PASSWORD="change-this-password"
